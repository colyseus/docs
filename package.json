{
  "private": true,
  "name": "colyseus-docs",
  "version": "0.0.1",
  "description": "Colyseus Documentation",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "node scripts/generate-ai-nav.js && next build && node scripts/place-markdown.js",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit",
    "generate:ai-nav": "node scripts/generate-ai-nav.js",
    "check:ai-nav": "node scripts/generate-ai-nav.js --check",
    "check-links": "node scripts/check-links.js",
    "lint:prose": "node scripts/lint-prose.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colyseus/docs.git"
  },
  "author": "Endel Dreyer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/colyseus/docs/issues"
  },
  "homepage": "https://github.com/colyseus/docs#readme",
  "dependencies": {
    "@next/third-parties": "^16.3.6",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.14",
    "lucide-react": "^1.48.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "^12.0.0",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "github-slugger": "^2.0.0",
    "js-yaml": "^5.4.2",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "postcss": "^8.5.28",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "packageManager": "pnpm@10.10.0"
}
